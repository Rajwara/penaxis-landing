# SMTP settings for the contact forms (Hostinger mailbox).
# Set the real values in Vercel → Project Settings → Environment Variables.
# Never commit an actual .env file with real credentials — .env is gitignored.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=adeel.aslam@penaxis.com
SMTP_PASS=

# Optional — where submissions are delivered. Defaults to SMTP_USER if unset.
CONTACT_TO_EMAIL=adeel.aslam@penaxis.com
